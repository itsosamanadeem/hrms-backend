**pycache**/
*.py[cod]
*.pyo
*.pyd

#db migrations
hrms/alembic/versions/*.py
hrms/alembic/versions/*.pyc

# Environment and virtual environment

hrms/.env/
hrms/*.env
hrms/config.env

# VS Code

.vscode/

# MacOS

.DS_Store

