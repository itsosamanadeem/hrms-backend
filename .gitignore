*.log

# Database files (optional)

*.sqlite3

# Pytest cache

.pytest_cache/

# MyPy cache

.mypy_cache/

# Coverage reports

htmlcov/
.coverage

# Pydantic model rebuild cache (if any)

.pydantic_cache/
