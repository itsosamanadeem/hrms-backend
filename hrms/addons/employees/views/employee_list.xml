<?xml version="1.0" encoding="utf-8"?>
<data>
    <record id="view_employee_list" model="ir_hr_view">
        <field name="name">employee.list</field>
        <field name="model">hr_employee</field>
        <field name="arch" type="xml">
            <list string="Employees">
                <field name="profile_image" string="Employee Profile" widget="imagebox"/>
                <field name="emp_name" string="Employee Name"/>
                <field name="email" string="Email"/>
                <field name="phone" string="Phone"/>
                <field name="address" string="Address"/>
                <field name="job_title" string="Job Title"/>
                <field name="dep_name" string="Department Name"/>
            </list>
        </field>
    </record>
</data>